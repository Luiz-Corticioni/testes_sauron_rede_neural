{
  "openapi": "3.1.0",
  "info": {
    "title": "Sauron — API de consultas v1",
    "version": "1.0.0",
    "description": "Consultas por sessão Django com MFA ou credencial de integração restrita por escopo. Emissão e gestão exigem sessão administrativa, MFA e reautenticação."
  },
  "security": [
    {
      "sessao": []
    }
  ],
  "paths": {
    "/api/v1/ativos/": {
      "get": {
        "operationId": "listarAtivos",
        "summary": "Listar ativos com paginação, busca e ordenação",
        "description": "A ordem -risco usa o risco efetivo do perfil puro e exige também acesso a vulnerabilidades, incidências e dependências. Token: escopo ativos, ou risco para ordenar=-risco.",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "busca",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "ordenar",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "nome",
                "-risco"
              ],
              "default": "id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de resultados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "pagina",
                    "tamanho",
                    "total",
                    "paginas",
                    "resultados"
                  ],
                  "properties": {
                    "pagina": {
                      "type": "integer"
                    },
                    "tamanho": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "paginas": {
                      "type": "integer"
                    },
                    "resultados": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Ativo"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "422": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "503": {
            "description": "Risco indisponível durante atualização do inventário",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessao": []
          },
          {
            "integracao": []
          }
        ]
      }
    },
    "/api/v1/vulnerabilidades/{pk}/ativos/": {
      "get": {
        "operationId": "listarAtivosAfetados",
        "summary": "Listar incidências e ativos afetados por uma vulnerabilidade",
        "parameters": [
          {
            "name": "pk",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "VUL-RCE-0001"
          },
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de resultados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "pagina",
                    "tamanho",
                    "total",
                    "paginas",
                    "resultados"
                  ],
                  "properties": {
                    "pagina": {
                      "type": "integer"
                    },
                    "tamanho": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "paginas": {
                      "type": "integer"
                    },
                    "resultados": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AtivoAfetado"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "422": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessao": []
          },
          {
            "integracao": []
          }
        ],
        "description": " Token: escopo incidencias."
      }
    },
    "/api/v1/credenciais/": {
      "post": {
        "operationId": "criarCredencial",
        "summary": "Criar credencial de leitura",
        "security": [
          {
            "sessao": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "escopos": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "ativos",
                        "risco",
                        "incidencias"
                      ]
                    }
                  },
                  "dias": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 90
                  }
                },
                "required": [
                  "escopos",
                  "dias"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Concluído",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "escopos",
                    "expira_em",
                    "segredo"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "escopos": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "ativos",
                          "risco",
                          "incidencias"
                        ]
                      }
                    },
                    "expira_em": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "segredo": {
                      "type": "string",
                      "description": "Exibido uma única vez; nunca registre em logs."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sessão necessária",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "MFA, CSRF ou autorização necessária",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Credencial não encontrada",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "422": {
            "description": "Entrada inválida",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listarCredenciais",
        "summary": "Listar credenciais do administrador sem segredos",
        "security": [
          {
            "sessao": []
          }
        ],
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de credenciais"
          },
          "401": {
            "description": "Sessão necessária"
          },
          "403": {
            "description": "Acesso negado"
          },
          "404": {
            "description": "Página não encontrada"
          },
          "422": {
            "description": "Parâmetro inválido"
          }
        }
      }
    },
    "/api/v1/credenciais/{identificador}/rotacionar/": {
      "post": {
        "operationId": "rotacionarCredencial",
        "summary": "Rotacionar credencial de leitura",
        "security": [
          {
            "sessao": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "dias": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 90
                  }
                },
                "required": [
                  "dias"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Concluído",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "escopos",
                    "expira_em",
                    "segredo"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "escopos": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "ativos",
                          "risco",
                          "incidencias"
                        ]
                      }
                    },
                    "expira_em": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "segredo": {
                      "type": "string",
                      "description": "Exibido uma única vez; nunca registre em logs."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sessão necessária",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "MFA, CSRF ou autorização necessária",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Credencial não encontrada",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "422": {
            "description": "Entrada inválida",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "identificador",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/credenciais/{identificador}/revogar/": {
      "post": {
        "operationId": "revogarCredencial",
        "summary": "Revogar credencial de leitura",
        "security": [
          {
            "sessao": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Concluído"
          },
          "401": {
            "description": "Sessão necessária",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "MFA, CSRF ou autorização necessária",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Credencial não encontrada",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "422": {
            "description": "Entrada inválida",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "identificador",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/qualidade/ativos/{pk}/": {
      "get": {
        "operationId": "qualidadeAtivo",
        "summary": "Avaliar evidências de um ativo em contexto declarado",
        "description": "A revisão exige perímetro e camada; sem contexto o índice composto é indisponível. Somente sessão com MFA e permissões de cobertura.",
        "security": [
          {
            "sessao": []
          }
        ],
        "parameters": [
          {
            "name": "pk",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "perimetro",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "REDE",
                "NEGOCIO",
                "IDENTIDADE"
              ],
              "default": "REDE"
            }
          },
          {
            "name": "principal",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Componentes e índice de completude de evidências",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualidadeDados"
                }
              }
            }
          },
          "401": {
            "description": "Sessão necessária",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Permissão ou MFA necessário",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Registro não encontrado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "422": {
            "description": "Contexto inválido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/qualidade/servicos/{pk}/": {
      "get": {
        "operationId": "qualidadeServico",
        "summary": "Avaliar evidências de um serviço",
        "description": "Usa o perímetro declarado e a camada NEGOCIO. Somente sessão com MFA e permissões de cobertura.",
        "security": [
          {
            "sessao": []
          }
        ],
        "parameters": [
          {
            "name": "pk",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Componentes e índice de completude de evidências",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualidadeDados"
                }
              }
            }
          },
          "401": {
            "description": "Sessão necessária",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Permissão ou MFA necessário",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Registro não encontrado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "422": {
            "description": "Contexto inválido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/qualidade/fontes/": {
      "get": {
        "operationId": "qualidadeFontes",
        "summary": "Consultar estado local das fontes",
        "description": "Leitura local; importações e iscas dependem de permissões adicionais. Não verifica conectividade atual.",
        "security": [
          {
            "sessao": []
          }
        ],
        "responses": {
          "200": {
            "description": "Estado das fontes NVD, EPSS e KEV, além de importações autorizadas"
          },
          "401": {
            "description": "Sessão necessária",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessao": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid",
        "description": "Sessão estabelecida em /entrar/ e verificada em /mfa/. O cookie isolado não substitui o segundo fator."
      },
      "integracao": {
        "type": "http",
        "scheme": "bearer",
        "description": "Credencial de integração com escopo explícito; não é JWT. Somente as duas rotas de consulta aceitam esta autenticação."
      }
    },
    "schemas": {
      "Problema": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Ativo": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "hostname",
          "tipo",
          "criticidade",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "1D00001"
          },
          "nome": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "criticidade": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "risco_efetivo": {
            "type": "number",
            "description": "Presente apenas para ordenação por risco; pontos, não probabilidade."
          }
        }
      },
      "AtivoAfetado": {
        "type": "object",
        "required": [
          "id",
          "status",
          "ativo_id",
          "ativo__nome",
          "ativo__hostname"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "ativo_id": {
            "type": "string"
          },
          "ativo__nome": {
            "type": "string"
          },
          "ativo__hostname": {
            "type": "string"
          }
        }
      },
      "QualidadeDados": {
        "type": "object",
        "required": [
          "versao",
          "score",
          "metodo",
          "componentes",
          "aviso"
        ],
        "properties": {
          "versao": {
            "type": "string",
            "const": "sauron.qualidade/1"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "description": "Índice de completude; nulo se um componente for indeterminado."
          },
          "metodo": {
            "type": "string"
          },
          "componentes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "codigo",
                "nome",
                "validos",
                "total",
                "percentual",
                "origem",
                "data",
                "motivo"
              ],
              "properties": {
                "codigo": {
                  "type": "string"
                },
                "nome": {
