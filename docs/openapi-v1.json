{
  "openapi": "3.1.0",
  "info": {
    "title": "Sauron — API de consultas v1",
    "version": "1.0.0",
    "description": "Consultas autenticadas por sessão Django com MFA concluído. A documentação cobre somente as duas rotas v1 descritas; as rotas antigas não estão incluídas. Escritas não são oferecidas por esta versão."
  },
  "security": [
    {
      "sessao": []
    }
  ],
  "paths": {
    "/api/v1/ativos/": {
      "get": {
        "operationId": "listarAtivos",
        "summary": "Listar ativos com paginação, busca e ordenação",
        "description": "A ordem -risco usa o risco efetivo do perfil puro e exige também acesso a vulnerabilidades, incidências e dependências.",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "busca",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "ordenar",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "nome",
                "-risco"
              ],
              "default": "id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de resultados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "pagina",
                    "tamanho",
                    "total",
                    "paginas",
                    "resultados"
                  ],
                  "properties": {
                    "pagina": {
                      "type": "integer"
                    },
                    "tamanho": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "paginas": {
                      "type": "integer"
                    },
                    "resultados": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Ativo"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "422": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/vulnerabilidades/{pk}/ativos/": {
      "get": {
        "operationId": "listarAtivosAfetados",
        "summary": "Listar incidências e ativos afetados por uma vulnerabilidade",
        "parameters": [
          {
            "name": "pk",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "VUL-RCE-0001"
          },
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de resultados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "pagina",
                    "tamanho",
                    "total",
                    "paginas",
                    "resultados"
                  ],
                  "properties": {
                    "pagina": {
                      "type": "integer"
                    },
                    "tamanho": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "paginas": {
                      "type": "integer"
                    },
                    "resultados": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AtivoAfetado"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "422": {
            "description": "Erro em Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessao": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid",
        "description": "Sessão estabelecida em /entrar/ e verificada em /mfa/. O cookie isolado não substitui o segundo fator."
      }
    },
    "schemas": {
      "Problema": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Ativo": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "hostname",
          "tipo",
          "criticidade",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "1D00001"
          },
          "nome": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "criticidade": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "risco_efetivo": {
            "type": "number",
            "description": "Presente apenas para ordenação por risco; pontos, não probabilidade."
          }
        }
      },
      "AtivoAfetado": {
        "type": "object",
        "required": [
          "id",
          "status",
          "ativo_id",
          "ativo__nome",
          "ativo__hostname"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "ativo_id": {
            "type": "string"
          },
          "ativo__nome": {
            "type": "string"
          },
          "ativo__hostname": {
            "type": "string"
          }
        }
      }
    }
  }
}
