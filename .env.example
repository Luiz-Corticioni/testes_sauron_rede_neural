# Este exemplo é recusado em produção até que a chave seja substituída.
# Alternativa recomendada: python scripts/preparar_ambiente.py
SAURON_SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-50-caracteres
SAURON_DEBUG=0
SAURON_ALLOWED_HOSTS=localhost,127.0.0.1
SAURON_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SAURON_SEED=0
SAURON_SECURE_COOKIES=0
SAURON_ADMIN_USER=
SAURON_ADMIN_PASSWORD=
NVD_API_KEY=
SAURON_RISCO_KAPPA=0.3
SAURON_RISCO_TAU=25
SAURON_LIMIAR_TENDENCIA=10
SAURON_SLA_KEV=7
SAURON_SLA_CRITICA=7
SAURON_SLA_ALTA=30
SAURON_SLA_MEDIA=90
SAURON_SLA_BAIXA=180
SAURON_EOL_DIAS=90
SAURON_CERT_DIAS=45
SAURON_BACKUP_RETENCAO=7
SAURON_ROTINAS_INTERVALO=3600
SAURON_ROTINAS_SEM_REDE=0

# Recomendador imune: afinidade/força em 0..1; meia-vida em dias.
SAURON_IMUNE_LIMIAR=0.75
SAURON_IMUNE_RISCO=25
SAURON_IMUNE_MEIA_VIDA=30
SAURON_IMUNE_PISO=0.05
SAURON_IMUNE_POPULACAO=50
SAURON_IMUNE_TOLERANCIA=30
SAURON_IMUNE_REJEICAO=0.6
SAURON_IMUNE_MIN_REJEICOES=3

# CIDRs de proxies que sobrescrevem X-Forwarded-For (vazio = não confiar)
SAURON_TRUSTED_PROXIES=

SAURON_AUDIT_HMAC_KEY=
# Arquivo de âncoras protegido/replicado fora do volume do CMDB
SAURON_AUDIT_ANCHOR_PATH=
SAURON_AUDIT_SYSLOG=

DATABASE_URL=
SAURON_BACKUP_KEY=
SAURON_BACKUP_DESTINO_ADICIONAL=

# Produção exige pelo menos uma âncora; desenvolvimento pode operar sem ela.
# SAURON_EXIGIR_ANCORA=1

# E-mail para códigos de acesso. Configure com os dados do seu provedor SMTP.
# Credenciais são privadas: guarde este arquivo com permissão restrita.
SAURON_EMAIL_ENABLED=0
SAURON_EMAIL_HOST=
SAURON_EMAIL_PORT=587
SAURON_EMAIL_USER=
SAURON_EMAIL_PASSWORD=
SAURON_EMAIL_FROM=
SAURON_EMAIL_USE_TLS=1
SAURON_EMAIL_USE_SSL=0
